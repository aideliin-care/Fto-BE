# Copy to .env and fill in. .env is gitignored.
#
# Only ONE variable is actually required today: OPENAI_API_KEY. Everything
# else has a working default, and the whole system runs end to end with no
# key at all using the scripted driver.

# --- required to test the agent's language layer ------------------------
# Without it, make_driver() returns ScriptedDriver and the semantic layer is
# never exercised. This is the last untested seam before telephony.
OPENAI_API_KEY=sk-...

# Text chat-completions model. Default: gpt-4o-mini. Cheap enough that the
# full test table costs well under a cent.
# OPENAI_MODEL=gpt-4o-mini

# --- optional -----------------------------------------------------------
# Where the appointment service lives. Default: http://127.0.0.1:8787
# CLINIC_API=http://127.0.0.1:8787

# SQLite database location. On Railway, set this to /data/clinic.db after
# attaching a Volume at /data; otherwise appointments disappear on redeploy.
# CLINIC_DB_PATH=/data/clinic.db

# --- Twilio phone demo --------------------------------------------------
# The adapter validates every incoming webhook with this token. Do not omit it.
TWILIO_AUTH_TOKEN=...

# The public HTTPS origin of your tunnel or deployment, without a trailing /.
# It must exactly match the URL configured on the Twilio phone number.
PUBLIC_BASE_URL=https://your-public-tunnel.example

# Optional. When the agent must hand off, it dials this clinic number.
# HANDOFF_NUMBER=+886...
